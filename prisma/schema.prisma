generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
  SPAM
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  ARTICLE_CREATED
  ARTICLE_UPDATED
  ARTICLE_PUBLISHED
  ARTICLE_ARCHIVED
  ARTICLE_REPUBLISHED
  COMMENT_APPROVED
  COMMENT_HIDDEN
  COMMENT_MARKED_SPAM
  COMMENT_DELETED
  SESSION_REVOKED
}

model admin_users {
  id                 String           @id @default(uuid()) @db.Uuid
  email              String           @unique @db.VarChar(255)
  password_hash      String           @db.VarChar(255)
  full_name          String           @db.VarChar(150)
  role               AdminRole        @default(ADMIN)
  is_active          Boolean          @default(true)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @updatedAt @db.Timestamptz(6)
  sessions           admin_sessions[]
  authored_posts     blog_posts[]
  moderated_comments comments[]       @relation("ModeratedComments")
  audit_logs         audit_logs[]
}

model admin_sessions {
  id         String      @id @default(uuid()) @db.Uuid
  user_id    String      @db.Uuid
  token_hash String      @unique @db.VarChar(64)
  expires_at DateTime    @db.Timestamptz(6)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  user       admin_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_admin_sessions_expires_at")
}

model blog_posts {
  id                 Int          @id @default(autoincrement())
  slug               String       @unique @db.VarChar(255)
  title_ar           String
  title_en           String
  excerpt_ar         String
  excerpt_en         String
  content_ar         String
  content_en         String
  category_ar        String       @db.VarChar(100)
  category_en        String       @db.VarChar(100)
  read_time_ar       String       @db.VarChar(50)
  read_time_en       String       @db.VarChar(50)
  image              String
  likes              Int?         @default(0)
  views              Int?         @default(0)
  status             PostStatus   @default(DRAFT)
  seo_title_ar       String?      @db.VarChar(255)
  seo_title_en       String?      @db.VarChar(255)
  seo_description_ar String?      @db.VarChar(500)
  seo_description_en String?      @db.VarChar(500)
  og_image           String?
  author_id          String?      @db.Uuid
  published_at       DateTime?    @db.Timestamptz(6)
  created_at         DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  author             admin_users? @relation(fields: [author_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  comments           comments[]

  @@index([status, published_at], map: "idx_blog_posts_status_published")
}

model comments {
  id           Int           @id @default(autoincrement())
  post_id      Int?
  user_name    String        @db.VarChar(150)
  text         String
  status       CommentStatus @default(PENDING)
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  moderated_at DateTime?     @db.Timestamptz(6)
  moderated_by String?       @db.Uuid
  blog_posts   blog_posts?   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  moderator    admin_users?  @relation("ModeratedComments", fields: [moderated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, created_at], map: "idx_comments_status_created")
  @@index([post_id, status], map: "idx_comments_post_status")
}

model audit_logs {
  id                 String       @id @default(uuid()) @db.Uuid
  admin_user_id      String?      @db.Uuid
  action             AuditAction
  entity_type        String?      @db.VarChar(50)
  entity_id          String?      @db.VarChar(100)
  metadata           Json?
  ip_hash            String?      @db.VarChar(64)
  user_agent_summary String?      @db.VarChar(255)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  actor              admin_users? @relation(fields: [admin_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([admin_user_id, created_at], map: "idx_audit_logs_user_created")
  @@index([action, created_at], map: "idx_audit_logs_action_created")
}

model rate_limit_entries {
  key        String   @id @db.VarChar(64)
  count      Int      @default(1)
  reset_at   BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([reset_at], map: "idx_rate_limit_reset")
}
